{
  "expo": {
    "name": "Be Positive",
    "slug": "be-positive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bepositive.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bepositive.app",
      "adaptiveIcon": {
        "backgroundColor": "#0808c1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "bepositive",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2F8FE0"
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.360468046824-1dp6cc53joq20l1tsh47fabk56eujb3t"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bu yerdə əhval-ruhiyyəni xəritəyə əlavə etmək üçün məkanından istifadə olunur."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "REPLACE_WITH_IOS_GOOGLE_MAPS_API_KEY",
          "androidGoogleMapsApiKey": "REPLACE_WITH_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil şəklini seçmək üçün fotolarına giriş lazımdır.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66251d99-6a42-4c06-bca2-0eb6a3e18a6c"
      }
    },
    "owner": "bepositiveapp"
  }
}
